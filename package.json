{
  "name": "collabboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc -b --pretty",
    "check": "tsc --noEmit -p tsconfig.json && tsx scripts/smoke.ts && tsx scripts/canvas-smoke.ts && tsx scripts/live-smoke.tsx && tsx scripts/dom-smoke.tsx",
    "test": "tsc --noEmit -p tsconfig.json && tsx scripts/smoke.ts && tsx scripts/canvas-smoke.ts && tsx scripts/live-smoke.tsx && tsx scripts/dom-smoke.tsx"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "lucide-react": "^0.453.0",
    "lz-string": "^1.5.0",
    "nanoid": "^5.0.7",
    "perfect-freehand": "^1.2.2",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "roughjs": "^4.6.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^30.0.0",
    "@types/lz-string": "^1.3.34",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
